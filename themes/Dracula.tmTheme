<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Dracula for syntect.

  syntect ships Solarized and the base16 family but not Dracula, so the palette
  is vendored here and referenced by name from themes/dracula.toml. Colours are
  from the Dracula specification (https://draculatheme.com), MIT licensed.
-->
